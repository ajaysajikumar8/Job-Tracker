# Copy to .env.local at the repo root (git-ignored) and fill in. Never commit real values.
# Web, worker and bootstrap all read that one file. Keep it OUTSIDE data/, so copying or syncing data/ never carries the key.
# The app never writes env files. See docs/adr/0009-recovery-key-storage.md.

# ── Recovery key (required for a local install) ───────
# Encrypts the database and every backup. 64 hex characters (32 random bytes).
# Generate with: openssl rand -hex 32    (or run: pnpm keygen)
# Save a copy outside this machine (a password manager). If it is lost, the data
# and every backup made with it are unrecoverable.
RECOVERY_KEY=

# ── AI (optional; off by default; see docs/adr/0005-ai-strategy.md) ─
# These are DEFAULTS. Anything changed in Settings -> AI overrides them (Settings can reset a field to its default).
# AI_MODE is one of: none | ollama | byok
AI_MODE=none
# In Docker, localhost is the container: use http://host.docker.internal:11434/v1 to reach Ollama on the host.
OLLAMA_BASE_URL=http://localhost:11434/v1
# Pinned: changing the embedding model re-embeds everything.
EMBEDDING_MODEL=nomic-embed-text
EXTRACTION_MODEL=llama3.2:3b
# BYOK: any OpenAI-compatible endpoint. Leave empty unless AI_MODE=byok.
BYOK_BASE_URL=
BYOK_API_KEY=
BYOK_MODEL=
# Sending personal data to a BYOK provider is a consent choice made in Settings only. It is never set here.

# ── Public demo only (leave unset for a local install) ─
# Read-only mode: all writes, uploads, backup, restore and AI are rejected.
# DEMO_MODE=1
# Hosted libSQL database holding the fake demo data. With DEMO_MODE=1 the app does not require or read RECOVERY_KEY.
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=
