# ── Secrets & environment ─────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key

# ── Sensitive user data (resumes, PII, DB dumps) ──────
/data/
*.db-wal
*.db-shm
uploads/
storage/
*.pdf
*.docx
*.sqlite
*.sqlite3
*.db
*.dump
*.sql.gz
pgdata/
