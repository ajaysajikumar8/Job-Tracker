# Copy to .env and fill in real values. Never commit .env.

# ── Database (PostgreSQL 16 + pgvector) ───────────────
POSTGRES_USER=jobtracker
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jobtracker
DATABASE_URL=postgresql://jobtracker:change-me@localhost:5432/jobtracker

# ── Redis (Celery broker + cache) ─────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Auth.js v5 ────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# ── Internal service communication ────────────────────
ENGINE_BASE_URL=http://localhost:8000
# Shared secret for Next.js -> FastAPI calls. Generate with: openssl rand -hex 32
ENGINE_API_TOKEN=

# ── AI / LLM (see ADR 0007) ───────────────────────────
AI_PROVIDER=local               # "local" | "cloud" | "hybrid"
OLLAMA_BASE_URL=http://localhost:11434/v1
EMBEDDING_MODEL=nomic-embed-text
EXTRACTION_MODEL=phi3:mini
CLOUD_MODEL=gpt-4o-mini
OPENAI_API_KEY=                 # Only required if AI_PROVIDER != "local"
